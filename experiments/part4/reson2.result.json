 "provenance": {
  "SOFT": "FULL pre-registered protocol, 45/45 units, all 3 D, all 5 rungs; source reson2.cheap-arms.full.json (identical science to a serial reson2.main() run -- verified unit-for-unit against the original SMOKE output)",
  "STD": "FULL pre-registered protocol, 45/45 units, all 3 D, all 5 rungs; source reson2.cheap-arms.full.json (identical science to a serial reson2.main() run -- verified unit-for-unit against the original SMOKE output)",
  "STD-CHAOS": "FULL pre-registered protocol, 45/45 units, all 3 D, all 5 rungs; source reson2.cheap-arms.full.json (identical science to a serial reson2.main() run -- verified unit-for-unit against the original SMOKE output)",
  "OSC": "PARTIAL-BY-DIMENSION. OSC is protocol-complete at D=512: 5 rungs (M=105, M=1,155, M=15,015, M=255,255, M=4,849,845); D=1024: 2 rungs (M=105, M=1,155). 21 OSC units were measured in total (the 4-arm run was stopped at 156/180 units once the verdict was secure). D=4096 OSC was NOT run. Because C(OSC)=0 at the EASIEST rung (M=105) at every completed D, the unmeasured D=4096 point is unmeasured-AND-CANNOT-HELP: it cannot change the verdict. Break rule: the pre-registered harness stops an arm after two consecutive sub-threshold rungs, which is why D=1024 has 2 rungs while D=512 was measured to the full 5-rung ladder.",
  "OSC_caveat": "Do not read OSC at D=4096 as unmeasured-but-good."
 },
 "verdict": {
  "RESON-1_STD_as_pre_registered": "KILL",
  "RESON-1_STD_verdict_validity": "INVALID -- initialization confound; see reson2.diag3.json. Same update rule with codebook-centroid init gives C=105/1155/1155. REISSUE as INCONCLUSIVE, not KILL.",
  "RESON-2_OSC_ge_STD": true,
  "RESON-2_OSC_ge_STD_note": "Vacuously true: OSC C=0 and STD C=0. The informative comparison is OSC vs SOFT, where OSC C=0 < SOFT C={105,1155,15015}. OSC FAILS the intent of the bar ('at least as capable as the discrete one') against every arm that works.",
  "CHAOS_C_ge_STD": true,
  "CHAOS_note": "Vacuously true (0>=0). Chaos-game is strictly WORSE than STD on accuracy at every measured point and INCREASES limit cycles, e.g. D=512 M=1155 acc 0.280 vs 0.300 and cycle_rate 0.900 vs 0.833. The brief's bar PASS condition (cycle_rate <= half of STD) FAILS.",
  "IFS_contraction_predicts_knee": "FAIL -- contraction_gm is monotone in M and is small exactly where accuracy is high; it never crosses 1.0 at any knee. It is a dist-to-truth ratio, not the IFS Lyapunov exponent E[log L]."
 },
